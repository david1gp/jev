{
  "name": "@adaptive-ds/jev",
  "version": "0.1.0",
  "description": "Initial TypeScript library and CLI scaffold for the Adaptive DS ecosystem.",
  "keywords": [
    "typescript",
    "cli",
    "library",
    "bun",
    "adaptive-ds"
  ],
  "homepage": "https://github.com/david1gp/jev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/david1gp/jev.git"
  },
  "bugs": {
    "url": "https://github.com/david1gp/jev/issues"
  },
  "author": {
    "name": "David Siewert",
    "url": "https://david-siewert.com/"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/david1gp"
  },
  "license": "MIT",
  "readme": "README.md",
  "type": "module",
  "private": false,
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22"
  },
  "packageManager": "bun@1.4.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "bun run src/cli.ts",
    "test": "bun test",
    "test:w": "bun test --watch",
    "type-check": "tsc --noEmit",
    "build": "rm -rf ./dist && tsc -p ./tsconfig.lib.json && chmod +x ./dist/cli.js",
    "deploy": "bash ./ops/deploy.sh",
    "release": "bash ./ops/release.sh",
    "format": "biome format --write src test package.json tsconfig.json tsconfig.lib.json biome.json bunfig.toml cliff.toml",
    "format:check": "biome format src test package.json tsconfig.json tsconfig.lib.json biome.json bunfig.toml cliff.toml",
    "check": "bun run format:check && bun run type-check && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/bun": "^1.3.13",
    "typescript": "^6.0.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./package.json": "./package.json",
    "./cli.js": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "jev": "./dist/cli.js"
  }
}
